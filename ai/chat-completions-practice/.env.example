# 复制本文件为 .env 后填写（.env 不要提交到 git）
#
# ========== 国内推荐（延迟更友好）==========
#
# --- 方案 D：硅基流动 SiliconFlow（推荐练手，一 Key 多模型，小模型常有免费）---
# 控制台：https://cloud.siliconflow.cn （或官网 siliconflow.cn → 获取 API Key）
# 文档兼容：BASE_URL 用下方地址即可对接本脚本
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 向量检索用（与对话模型可以不同；以控制台「Embeddings」列表为准）
LLM_EMBED_MODEL=BAAI/bge-m3
#
# --- 方案 E：智谱 GLM（OpenAI 兼容）---
# 开放平台：https://open.bigmodel.cn
# LLM_API_KEY=
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.5-flash
# LLM_EMBED_MODEL=embedding-3
#
# --- 方案 F：阿里云百炼 DashScope（通义，兼容模式）---
# 控制台：https://bailian.console.aliyun.com
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo
#
# --- 方案 G：DeepSeek（注册常送额度；用完后很便宜）---
# https://platform.deepseek.com
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
#
# ========== 海外 / 本机（备选）==========
#
# --- Groq（国外，国内常较慢）---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
#
# --- OpenRouter 免费路由 ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free
#
# --- Ollama 本机 ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2
